                        <size>
                         <width>22</width>
                         <height>22</height>
                        </size>
                       </property>
                       <property name="maximumSize">
                        <size>
                         <width>22</width>
                         <height>22</height>
                        </size>
                       </property>
                       <property name="focusPolicy">
                        <enum>Qt::NoFocus</enum>
                       </property>
                       <property name="toolTip">
                        <string>&lt;html&gt;&lt;body&gt;&lt;p&gt;Forces the response matrix to be triangular by setting the response of BPMs upstream of each actuator to zero.&lt;/p&gt;&lt;p&gt;Useful for transport lines or linacs. In a damping ring, the orbit is closed and each corrector can affect every BPM, so this option is usually not needed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                       </property>
                       <property name="styleSheet">
                        <string notr="true">QToolButton#triangular_tooltip {
